{
  "name": "@food-signal/api",
  "version": "0.1.0",
  "private": true,
  "description": "Food Signal API - Azure Functions (/api/analyze) and deterministic risk engine.",
  "main": "dist/src/functions/*.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.4.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@food-signal/shared": "*",
    "openai": "^4.67.0",
    "vite": "8.3.0-beta.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0",
    "vitest": "^5.0.0"
  }
}
