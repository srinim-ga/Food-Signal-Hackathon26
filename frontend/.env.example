# =============================================================================
# Food Signal frontend environment example (Vite)
# Copy to frontend/.env for local dev. Only VITE_* vars are exposed to the
# browser bundle - NEVER put secrets or Azure keys here.
# =============================================================================

# Base URL for the API. Empty means same-origin (/api), which is how Azure
# Static Web Apps serves the managed Functions API in production.
VITE_API_BASE_URL=

# App display name (branding only).
VITE_APP_NAME=Food Signal
